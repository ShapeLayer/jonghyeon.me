{
  "name": "@shapelayer/zoomable-image",
  "version": "0.1.0",
  "description": "Dependency-free zoomable image Web Component with captions and annotations",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "custom-elements.json",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "sideEffects": [
    "./dist/register.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "test:browser": "npm run build && playwright test",
    "test:release": "npm run check && npm run check:tests && npm test && npm run test:browser",
    "test:package": "node test/package.mjs",
    "test:integration": "pnpm --dir ../.. build && playwright test -c playwright.integration.config.ts",
    "check:tests": "tsc --noEmit --strict --target ES2022 --module NodeNext --lib ES2022,DOM,DOM.Iterable test/browser/viewer.spec.ts test/integration/site.spec.ts playwright.config.ts playwright.integration.config.ts playwright.dev.config.ts",
    "test:dev": "npm run build && playwright test -c playwright.dev.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@playwright/test": "^1.63.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShapeLayer/jonghyeon.me.git",
    "directory": "packages/zoomable-image"
  },
  "bugs": {
    "url": "https://github.com/ShapeLayer/jonghyeon.me/issues"
  },
  "homepage": "https://github.com/ShapeLayer/jonghyeon.me/tree/main/packages/zoomable-image#readme",
  "keywords": [
    "web-component",
    "custom-element",
    "image",
    "zoom",
    "caption",
    "annotation"
  ],
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "customElements": "custom-elements.json"
}
